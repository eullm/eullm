+// EuLLM: the experts of a large batch, copied ahead of the splits that read them.
+//
+// The experts of a MUL_MAT_ID in host memory are copied to the GPU before its split
+// runs: the host first reads the router's choice back, which waits for the GPU to
+// drain, and the copy then runs on the GPU's stream, where nothing computes while it
+// does. A long prompt alternates the two for every expert tensor of every layer.
+//
+// Turned on with ggml_backend_sched_set_moe_prefetch, a MUL_MAT_ID of at least
+// `min_tokens` tokens (llama.cpp asks for 512: nearly every expert is used by then)
+// reads its experts from one of a few slots in VRAM instead, which a second stream of
+// the same GPU fills, a whole tensor at a time, while the splits before it compute. No
+// host wait for the router is left on that path. Each slot has two events: `copied`,
+// which the split that reads the slot waits for on the GPU, and `freed`, recorded once
+// that split is queued, which the next copy into the slot waits for. `n_slots` (2 to 8)
+// is how many tensors can be in flight; a slot holds the largest of them. Measured in
+// EuLLM on a 33,200-token prompt, the experts of three tensors a layer in RAM: two
+// slots read it 10-15% faster than the scheduler alone, three 18%, four 24-42%, six
+// and eight no faster than four.
+//
+// One CUDA GPU, one copy of the graph (no pipeline parallelism), and the experts in
+// the GPU's pinned host buffer, where a model loaded without mmap has them: from
+// pageable memory a copy would hold the host until its slot is free. The slots are
+// made only if they leave a twentieth of the VRAM, and at least 512 MiB, to what a
+// compute allocates as it goes.
+#define GGML_SCHED_PREFETCH_MAX_SLOTS 8
+
+struct ggml_backend_sched_prefetch_input {
+    int split_id;
+    struct ggml_tensor * input;     // the experts, in pinned host memory
+    struct ggml_tensor * input_cpy; // the split's copy of them, placed in a slot
+    int slot;
+};
+
+struct ggml_backend_sched_prefetch {
+    int  min_tokens;
+    int  n_slots;
+    bool failed;                    // something it needs is missing: off for good, said once
+
+    int backend_id;                 // the scheduler's backend the slots are for, -1 until the first input
+    ggml_backend_t copy_backend;    // a second instance of that backend, for a stream of its own
+    ggml_backend_buffer_t slots;    // the slots, one after the other
+    size_t slot_size;
+    ggml_backend_event_t copied[GGML_SCHED_PREFETCH_MAX_SLOTS];
+    ggml_backend_event_t freed[GGML_SCHED_PREFETCH_MAX_SLOTS];
+
+    std::vector<ggml_backend_sched_prefetch_input> inputs; // the current graph's, in split order
+    bool reused;                    // a staged copy is read by a later split as well: not this graph
+    bool placed;                    // the inputs are in their slots: their copies run ahead
+    bool was_placed;                // the previous graph's were [GGML_SCHED_DEBUG_REALLOC]
+};
+
 struct ggml_backend_sched {
     bool is_reset; // true if the scheduler has been reset since the last graph split
     bool is_alloc;
@@ -971,6 +1023,7 @@ struct ggml_backend_sched {
 
     ggml_backend_sched_realloc_callback callback_realloc;
     void * callback_realloc_user_data;
