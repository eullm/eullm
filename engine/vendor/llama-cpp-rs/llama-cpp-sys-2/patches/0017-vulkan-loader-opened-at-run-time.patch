-    target_link_libraries(ggml-vulkan PRIVATE Vulkan::Vulkan SPIRV-Headers::SPIRV-Headers)
+    # [EuLLM] the headers only: the loader is opened at run time (see ggml-vulkan.cpp), so a
+    # program built with Vulkan starts where no loader is installed.
+    target_link_libraries(ggml-vulkan PRIVATE Vulkan::Headers SPIRV-Headers::SPIRV-Headers ${CMAKE_DL_LIBS})
     target_include_directories(ggml-vulkan PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
 
     # Workaround to the "can't dereference invalidated vector iterator" bug in clang-cl debug build
