@@ -5892,6 +5892,33 @@ static void ggml_vk_print_gpu_info(size_t idx) {
 
 static DispatchLoaderDynamic ggml_vk_default_dispatcher_instance;
 
+// [EuLLM] The Vulkan loader is opened at run time instead of being linked: a build that carries
+// Vulkan beside CUDA has to start where no loader is installed (CUDA containers, servers, HPC
+// nodes) and only go without the Vulkan devices there. A missing loader throws, which
+// ggml_backend_vk_reg() turns into no Vulkan backend.
+#if VK_HEADER_VERSION >= 301
+using ggml_vk_dynamic_loader = vk::detail::DynamicLoader;
+#else
+using ggml_vk_dynamic_loader = vk::DynamicLoader;
+#endif
+
+static PFN_vkGetInstanceProcAddr ggml_vk_loader_get_instance_proc_addr() {
+    static std::unique_ptr<ggml_vk_dynamic_loader> loader;
+    if (!loader) {
+        try {
+            loader = std::make_unique<ggml_vk_dynamic_loader>();
+        } catch (const std::exception & e) {
+            GGML_LOG_INFO("ggml_vulkan: no Vulkan loader (%s): Vulkan devices are not used\n", e.what());
+            throw;
+        }
+    }
+    auto proc = loader->getProcAddress<PFN_vkGetInstanceProcAddr>("vkGetInstanceProcAddr");
+    if (!proc) {
+        throw std::runtime_error("the Vulkan loader has no vkGetInstanceProcAddr");
+    }
+    return proc;
+}
+
 DispatchLoaderDynamic & ggml_vk_default_dispatcher() {
     return ggml_vk_default_dispatcher_instance;
 }
