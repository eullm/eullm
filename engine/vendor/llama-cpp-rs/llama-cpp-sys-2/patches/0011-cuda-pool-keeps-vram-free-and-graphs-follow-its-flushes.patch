The legacy CUDA/HIP memory pool (the only one on HIP, where VMM is off by
default) keeps every buffer it allocated until an allocation fails; then it
frees its cached buffers and retries. On LUMI-G's MI250X under continuous
batching it grew by 1.3-2.5 GiB an hour until the GCD was full (Qwen3-32B
from 52 to 63.9 GiB in about eight hours): an allocation outside the pool
failed ("ROCm error: out of memory" at hipGraphInstantiate) and the server
aborted, or the pool's flush left the CUDA graphs captured before it pointing
into freed temporaries, and every replay computed NaN or faulted
(HSA_STATUS_ERROR_MEMORY_APERTURE_VIOLATION).

Before allocating a new buffer, the pool now frees its cached buffers when the
allocation would leave less than GGML_CUDA_POOL_KEEP_FREE_MB of VRAM free (512
by default; 0 keeps them until an allocation fails, as before), unless a graph
is being captured. That flush drops the
context's CUDA graphs, so they are captured again with live addresses: upstream
does the same since b11925 when the pool frees after a failed allocation
(invalidate_cuda_graphs), and this patch calls it from its own flush.

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 558ba7c2..f5806942 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -438,6 +438,25 @@ const ggml_cuda_device_info & ggml_cuda_info() {
 
 // #define DEBUG_CUDA_MALLOC
 
+// Whether a CUDA graph is being captured, on any context: freeing the cached
+// buffers then would break the capture, or free the temporaries it recorded.
+static bool ggml_cuda_graph_capture_in_progress();
+
+// The VRAM a legacy pool leaves free when it allocates a buffer, freeing its
+// cached buffers first when it would leave less. The pool keeps every buffer it
+// ever allocated until an allocation fails; on LUMI-G's MI250X (HIP, where the
+// legacy pool is the default) it grew by 1.3-2.5 GiB an hour under continuous
+// batching until the GCD was full, and an allocation outside the pool
+// (hipGraphInstantiate) failed. GGML_CUDA_POOL_KEEP_FREE_MB, 512 by default, 0
+// to keep buffers until an allocation fails as before.
+static size_t ggml_cuda_pool_keep_free() {
+    static const size_t keep_free = [] {
+        const char * env = getenv("GGML_CUDA_POOL_KEEP_FREE_MB");
+        return (env != nullptr ? (size_t) atoll(env) : (size_t) 512) << 20;
+    }();
+    return keep_free;
+}
+
 // buffer pool for cuda (legacy)
 struct ggml_cuda_pool_leg : public ggml_cuda_pool {
     static const int MAX_BUFFERS = 256;
@@ -496,9 +515,11 @@ struct ggml_cuda_pool_leg : public ggml_cuda_pool {
 #endif
         size_t best_diff = 1ull << 36;
         int ibest = -1;
+        size_t cached = 0;
         for (int i = 0; i < MAX_BUFFERS; ++i) {
             ggml_cuda_buffer& b = buffer_pool[i];
             if (b.ptr != nullptr) {
+                cached += b.size;
 #ifdef DEBUG_CUDA_MALLOC
                 ++nnz;
                 if (b.size > max_size) max_size = b.size;
@@ -531,6 +552,18 @@ struct ggml_cuda_pool_leg : public ggml_cuda_pool {
         size_t look_ahead_size = (size_t) (1.05 * size);
         look_ahead_size = 256 * ((look_ahead_size + 255)/256);
         ggml_cuda_set_device(device);
+        if (cached > 0 && ggml_cuda_pool_keep_free() > 0 && !ggml_cuda_graph_capture_in_progress()) {
+            size_t free_mem = 0;
+            size_t total_mem = 0;
+            if (cudaMemGetInfo(&free_mem, &total_mem) == cudaSuccess &&
+                    free_mem < look_ahead_size + ggml_cuda_pool_keep_free()) {
+                GGML_LOG_INFO(GGML_CUDA_NAME " pool[%d]: %.2f MiB free, freeing %.2f MiB of cached buffers before allocating %.2f MiB\n",
+                              device, free_mem/1024.0/1024.0, cached/1024.0/1024.0, look_ahead_size/1024.0/1024.0);
+                CUDA_CHECK(cudaDeviceSynchronize());
+                clear_pool();
+                invalidate_cuda_graphs();
+            }
+        }
         cudaError_t err = ggml_cuda_device_malloc(&ptr, look_ahead_size, device);
         if (err == cudaErrorMemoryAllocation) {
             (void)cudaGetLastError();
@@ -741,6 +774,10 @@ static std::mutex ggml_cuda_lock;
 static std::condition_variable ggml_cuda_lock_cv;
 static std::atomic<int> ggml_cuda_lock_counter;
 
+static bool ggml_cuda_graph_capture_in_progress() {
+    return ggml_cuda_lock_counter.load(std::memory_order_relaxed) > 0;
+}
+
 ggml_backend_cuda_context::~ggml_backend_cuda_context() {
     std::unique_lock<std::mutex> lock(ggml_cuda_lock);
     ggml_cuda_lock_cv.wait(lock, []{ return ggml_cuda_lock_counter.load(std::memory_order_relaxed) == 0; });
