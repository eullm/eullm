+    // EuLLM: GGML_CUDA_MMQ_FEW=0 leaves 2-24 columns to MMVQ and MMQ, as before this kernel
+    static const bool disabled = [] {
+        const char * env = getenv("GGML_CUDA_MMQ_FEW");
+        return env != nullptr && strcmp(env, "0") == 0;
+    }();
+    if (disabled) {
+        return false;
+    }
     const int min_ncols = ggml_cuda_mmq_few_min_ncols(src0->type, cc, src0->ne[0]);
     if (min_ncols == 0 || src1->ne[1] < min_ncols || src1->ne[1] > MMQ_FEW_MAX_NCG*MMQ_FEW_NCOLS) {
         return false;
