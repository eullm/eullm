@@ -2269,6 +2343,12 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
         prev_backend_id = split_backend_id;
     }
 
+    if (pf != NULL && pf->bytes_vram > 0 && !pf->said_vram) {
