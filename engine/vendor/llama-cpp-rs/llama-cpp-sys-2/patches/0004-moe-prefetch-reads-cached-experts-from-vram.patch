+    // the slots of the experts of host tensor src the cache holds, -1 for the others; the slot of a
+    // (layer, expert) is the same in the banks of all of the layer's projections
+    bool lookup(const ggml_tensor * src, const ggml_tensor ** bank, int32_t * slot_of) const {
+        const auto it = bindings.find(src);
+        if (it == bindings.end()) {
+            return false;
+        }
+        const binding & b = it->second;
+        const group & g = groups[layers[b.il].ig];
+        const int32_t * slots = g.slru.slot_map[b.il];
+        if (slots == nullptr || src->ne[2] != g.slru.n_expert) {
+            return false;
+        }
+        bool any = false;
+        for (int32_t e = 0; e < g.slru.n_expert; ++e) {
+            slot_of[e] = slots[e];
+            any = any || slots[e] >= 0;
+        }
+        *bank = g.banks[b.ip];
+        return any;
+    }
+
     bool copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, ggml_cgraph * graph) {
         const auto it = layer_of.find(src);
         if (it == layer_of.end()) {
@@ -918,3 +940,7 @@ std::map<ggml_backend_buffer_type_t, size_t> llama_moe_cache::memory_breakdown()
     }
     return res;
 }
+
+bool llama_moe_cache::sched_lookup(void * user_data, const ggml_tensor * src, const ggml_tensor ** bank, int32_t * slot_of) {
+    return static_cast<llama_moe_cache *>(user_data)->pimpl->lookup(src, bank, slot_of);
+}
