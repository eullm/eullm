sampling: penalize the recent tokens at their own index when the candidates are the whole vocabulary

llama_sampler_penalties_apply looked every candidate up in the table of recent
tokens: one hash lookup per token of the vocabulary, for every token of every
sequence, on one thread. llama_sampler_sample builds the candidates as the
whole vocabulary in order (the candidate at index i is token i), so when each
penalized token is at its own index it is penalized there: penalty_last_n
lookups instead of n_vocab. Any other array (sorted, cut, reordered) is
scanned whole, as before. The logits come out the same, bit for bit.

On 248,320 tokens (Qwen3.5), 64 recent ones, repeat penalty 1.1: 1,196 us per
token before, 2 us after, same checksum over the whole array. With 16
sequences at once that was 19 ms of every decode step. test-sampling gains a
case for the arrays the fast path must leave alone.

EuLLM patch on llama.cpp b11925.

diff --git a/src/llama-sampler.cpp b/src/llama-sampler.cpp
index 9004efa2..f0eb5cd8 100644
--- a/src/llama-sampler.cpp
+++ b/src/llama-sampler.cpp
@@ -2961,26 +2961,45 @@ static void llama_sampler_penalties_apply(struct llama_sampler * smpl, llama_tok
         return;
     }
 
-    // Apply frequency and presence penalties to the cur_p
-    for (size_t i = 0; i < cur_p->size; ++i) {
-        const auto token_iter = ctx->token_count.find(cur_p->data[i].id);
-        if (token_iter == ctx->token_count.end()) {
-            continue;
-        }
-
-        const int count = token_iter->second;
-
+    const auto penalize = [ctx](llama_token_data & cur, int count) {
         assert(count > 0 && count <= ctx->penalty_last_n);
 
         // The academic publication that described this technique actually just only divided, but that would cause tokens with negative logits to become more likely, which is obviously wrong.
         // This is common fix for this problem, which is to multiply by the penalty instead of dividing.
-        if (cur_p->data[i].logit <= 0) {
-            cur_p->data[i].logit *= ctx->penalty_repeat;
+        if (cur.logit <= 0) {
+            cur.logit *= ctx->penalty_repeat;
         } else {
-            cur_p->data[i].logit /= ctx->penalty_repeat;
+            cur.logit /= ctx->penalty_repeat;
+        }
+
+        cur.logit -= float(count) * ctx->penalty_freq + float(count > 0) * ctx->penalty_present;
+    };
+
+    // When every penalized token is at its own index, as in the candidates llama_sampler_sample
+    // builds (the whole vocabulary, in order), penalize them there: penalty_last_n lookups
+    // instead of one per candidate of the vocabulary
+    bool by_index = true;
+    for (const auto & [token, count] : ctx->token_count) {
+        if (token < 0 || (size_t) token >= cur_p->size || cur_p->data[token].id != token) {
+            by_index = false;
+            break;
         }
+    }
 
-        cur_p->data[i].logit -= float(count) * ctx->penalty_freq + float(count > 0) * ctx->penalty_present;
+    if (by_index) {
+        for (const auto & [token, count] : ctx->token_count) {
+            penalize(cur_p->data[token], count);
+        }
+    } else {
+        // Apply frequency and presence penalties to the cur_p
+        for (size_t i = 0; i < cur_p->size; ++i) {
+            const auto token_iter = ctx->token_count.find(cur_p->data[i].id);
+            if (token_iter == ctx->token_count.end()) {
+                continue;
+            }
+
+            penalize(cur_p->data[i], token_iter->second);
+        }
     }
 
     cur_p->sorted = false;
diff --git a/tests/test-sampling.cpp b/tests/test-sampling.cpp
index 353a5a1a..b9453683 100644
--- a/tests/test-sampling.cpp
+++ b/tests/test-sampling.cpp
@@ -188,6 +188,37 @@ static void test_penalties(
     tester.check();
 }
 
+// The penalized tokens are found wherever they are among the candidates, and only there: in an
+// array out of vocabulary order, and in one that holds part of the vocabulary
+static void test_penalties_out_of_order() {
+    const float logit = logf(0.2f);
+
+    std::vector<llama_token_data> cur;
+    for (llama_token id = 4; id >= 0; --id) {
+        cur.push_back({ id, logit, 0.0f });
+    }
+    llama_token_data_array cur_p = { cur.data(), cur.size(), -1, false };
+    auto * sampler = llama_sampler_init_penalties(5, 3, 50.0f, 0.0f, 0.0f);
+    for (llama_token t : { 0, 1, 2 }) {
+        llama_sampler_accept(sampler, t);
+    }
+    llama_sampler_apply(sampler, &cur_p);
+    for (const auto & td : cur) {
+        GGML_ASSERT(fabs(td.logit - (td.id <= 2 ? logit * 50.0f : logit)) < 1e-5);
+    }
+
+    std::vector<llama_token_data> part = { { 0, logit, 0.0f }, { 1, logit, 0.0f } };
+    llama_token_data_array part_p = { part.data(), part.size(), -1, false };
+    llama_sampler_reset(sampler);
+    for (llama_token t : { 1, 3 }) {
+        llama_sampler_accept(sampler, t);
+    }
+    llama_sampler_apply(sampler, &part_p);
+    GGML_ASSERT(fabs(part[0].logit - logit) < 1e-5);
+    GGML_ASSERT(fabs(part[1].logit - logit * 50.0f) < 1e-5);
+    llama_sampler_free(sampler);
+}
+
 static void test_dry(
     const std::vector<float> & probs, const std::vector<llama_token> & last_tokens,
     const std::vector<float> & expected_probs, float dry_multiplier, float dry_base,
@@ -384,6 +415,7 @@ int main(void) {
     test_penalties({0.2f, 0.2f, 0.2f, 0.2f, 0.2f}, {0},             {0.000011f, 0.249997f, 0.249997f, 0.249997f, 0.249997f}, 1.0f, 5.0f, 5.0f);
     test_penalties({0.2f, 0.2f, 0.2f, 0.2f, 0.2f}, {0, 1, 2},       {0.000023f, 0.000023f, 0.000023f, 0.499966f, 0.499966f}, 1.0f, 5.0f, 5.0f);
     test_penalties({0.2f, 0.2f, 0.2f, 0.2f, 0.2f}, {0, 1, 2, 0, 0}, {0.000000f, 0.000023f, 0.000023f, 0.499977f, 0.499977f}, 1.0f, 5.0f, 5.0f);
+    test_penalties_out_of_order();
 
 
     test_dry({0.25f, 0.25f, 0.25f, 0.25f}, {0, 1}, {0.25f, 0.25f, 0.25f, 0.25f}, 1.0f, 1.1f, 2, 4, {});
