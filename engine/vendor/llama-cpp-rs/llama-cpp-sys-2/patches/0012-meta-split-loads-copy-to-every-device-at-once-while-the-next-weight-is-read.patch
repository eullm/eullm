+// Reads n bytes from offs into dst with n_threads positioned reads at once, in
+// pieces of 16 MiB. A weight of a tensor-split model read into memory was read
+// with one read of hundreds of MiB: on LUMI-G's Lustre Qwen3-235B's 132 GiB
+// took 209-253 s to read so, where layer split, reading 1 MiB at a time with
+// the file system's read-ahead running, loaded the whole model in 130 s
+// (next23, 22-10-2026). With 1, 8 and 16 threads it read in 234, 192 and
+// 125 s, Qwen3-Coder-480B's 270 GiB in 240, 127 and 93 s (next24).
+// Not for a file opened for direct I/O, whose reads have to be aligned.
+static void llama_read_at(llama_file & file, size_t offs, void * dst, size_t n, int n_threads) {
+#if defined(__linux__) || defined(__APPLE__)
+    const size_t piece = size_t(16) << 20;
+    if (n_threads > 1 && n > piece && !file.has_direct_io()) {
+        const int fd = file.file_id();
+        const size_t n_pieces = (n + piece - 1) / piece;
+        std::atomic<size_t> next{0};
+        std::atomic<int> err{0};
+        auto work = [&]() {
+            for (size_t i = next++; i < n_pieces && err.load() == 0; i = next++) {
+                size_t done = i * piece;
+                const size_t end = std::min(n, done + piece);
+                while (done < end) {
+                    const ssize_t r = pread(fd, (char *) dst + done, end - done, (off_t) (offs + done));
+                    if (r < 0 && errno == EINTR) {
+                        continue;
+                    }
+                    if (r <= 0) {
+                        err = r < 0 ? errno : -1;
+                        return;
+                    }
+                    done += (size_t) r;
+                }
+            }
+        };
+        std::vector<std::thread> threads;
+        for (size_t t = 1; t < std::min<size_t>(n_threads, n_pieces); t++) {
+            threads.emplace_back(work);
+        }
+        work();
+        for (std::thread & t : threads) {
+            t.join();
+        }
+        if (err.load() != 0) {
+            throw std::runtime_error(format("read error: %s", err.load() > 0 ? strerror(err.load()) : "unexpectedly reached end of file"));
+        }
+        return;
+    }
+#endif
+    file.seek(offs, SEEK_SET);
+    file.read_raw(dst, n);
+}
