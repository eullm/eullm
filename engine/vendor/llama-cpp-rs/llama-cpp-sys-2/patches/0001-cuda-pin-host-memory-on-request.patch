CUDA: pin host memory for a caller that asks for it

ggml_backend_cuda_register_host_buffer only pins when the GGML_CUDA_REGISTER_HOST
environment variable is set, and nothing in llama.cpp calls it. These two procs
pin and unpin on request, and say why when pinning fails:

  const char * ggml_backend_pin_host_buffer(void * buffer, size_t size); // NULL on success
  void         ggml_backend_unpin_host_buffer(void * buffer);

Read-only registration (cudaHostRegisterReadOnly) is what lets the pages of a
model mmap'd read-only be pinned.

EuLLM patch on llama.cpp b11925. Used by 0002.

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index aba21524..558ba7c2 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5457,6 +5457,32 @@ void ggml_backend_cuda_unregister_host_buffer(void * buffer) {
     }
 }
 
+// pin host memory for a caller that asks for it explicitly, without the GGML_CUDA_REGISTER_HOST opt-in
+// returns NULL on success, or why the memory could not be pinned
+static const char * ggml_backend_cuda_pin_host_buffer(void * buffer, size_t size) {
+#if CUDART_VERSION >= 11010 || defined(GGML_USE_MUSA) || defined(GGML_USE_HIP)
+    cudaError_t err = cudaHostRegister(buffer, size, cudaHostRegisterPortable | cudaHostRegisterReadOnly);
+    if (err != cudaSuccess) {
+        // clear the error
+        (void)cudaGetLastError();
+        return cudaGetErrorString(err);
+    }
+    return nullptr;
+#else
+    GGML_UNUSED(buffer);
+    GGML_UNUSED(size);
+    return "CUDA 11.1 or newer is required";
+#endif // CUDART_VERSION >= 11010 || defined(GGML_USE_MUSA)
+}
+
+static void ggml_backend_cuda_unpin_host_buffer(void * buffer) {
+    cudaError_t err = cudaHostUnregister(buffer);
+    if (err != cudaSuccess) {
+        // clear the error
+        (void)cudaGetLastError();
+    }
+}
+
 
 // backend device
 
@@ -6293,6 +6319,12 @@ static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, con
     if (strcmp(name, "ggml_backend_unregister_host_buffer") == 0) {
         return (void *)ggml_backend_cuda_unregister_host_buffer;
     }
+    if (strcmp(name, "ggml_backend_pin_host_buffer") == 0) {
+        return (void *)ggml_backend_cuda_pin_host_buffer;
+    }
+    if (strcmp(name, "ggml_backend_unpin_host_buffer") == 0) {
+        return (void *)ggml_backend_cuda_unpin_host_buffer;
+    }
     if (strcmp(name, "ggml_backend_get_features") == 0) {
         return (void *)ggml_backend_cuda_get_features;
     }
