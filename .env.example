# Copy this file to .env (in the directory you launch `eullm` from) to
# broaden which source IPs may reach the API and chat UI beyond localhost.
#
# With no .env file — or no EULLM_ALLOWED_IPS key in it — only 127.0.0.1
# and ::1 (loopback) are allowed, regardless of the server binding 0.0.0.0.
# Loopback always stays allowed even when you add entries below; you can't
# lock yourself out of local access by configuring a remote host.
#
# Comma-separated list of bare IPs and/or CIDR subnets. Examples:
#
#   A single RAG host calling the engine from another machine:
#     EULLM_ALLOWED_IPS=203.0.113.5
#
#   A whole LAN subnet (any device on 192.168.1.0/24):
#     EULLM_ALLOWED_IPS=192.168.1.0/24
#
#   Both, plus an IPv6 host:
#     EULLM_ALLOWED_IPS=203.0.113.5,192.168.1.0/24,2001:db8::1

EULLM_ALLOWED_IPS=
